          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.615686 0.639216 0.67451 1" mesh="Right_Support_Link"/>
          <geom type="mesh" rgba="0.615686 0.639216 0.67451 1" mesh="Right_Support_Link"/>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- Left_Support_Joint 模仿 Left_1_Joint (multiplier=-1) -->
    <joint joint1="Left_1_Joint" joint2="Left_Support_Joint" polycoef="0 -1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <!-- Left_2_Joint 模仿 Left_1_Joint (multiplier=1) -->
    <joint joint1="Left_1_Joint" joint2="Left_2_Joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <!-- Right_2_Joint 模仿 Left_1_Joint (multiplier=-1) -->
    <joint joint1="Left_1_Joint" joint2="Right_2_Joint" polycoef="0 -1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <!-- Right_1_Joint 模仿 Left_1_Joint (multiplier=-1) -->
    <joint joint1="Left_1_Joint" joint2="Right_1_Joint" polycoef="0 -1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <!-- Right_Support_Joint 模仿 Left_1_Joint (multiplier=-1) -->
    <joint joint1="Left_1_Joint" joint2="Right_Support_Joint" polycoef="0 -1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <contact>
    <exclude body1="base" body2="Left_1_Link"/>
    <exclude body1="base" body2="Left_Support_Link"/>
    <exclude body1="base" body2="Right_1_Link"/>
    <exclude body1="base" body2="Right_Support_Link"/>
    <exclude body1="Left_1_Link" body2="Left_2_Link"/>
    <exclude body1="Left_Support_Link" body2="Left_2_Link"/>
    <exclude body1="Right_1_Link" body2="Right_2_Link"/>
    <exclude body1="Right_Support_Link" body2="Right_2_Link"/>
  </contact>

  <actuator>
    <position name="Left_1_motor" joint="Left_1_Joint" ctrlrange="-0.91 0" kv="1" kp="30"/>
<!--    <motor name="Left_1_motor" joint="Left_1_Joint" ctrlrange="-1 1"/>-->
  </actuator>

</mujoco>
